pacman_install () {
  local packages=$@
  for package in ${packages[@]}; do
    sudo pacman -Sy $package --noconfirm --needed
  done
}

yay_install () {
  local packages=$@
  for package in ${packages[@]}; do
    yay -Sy $package --noconfirm --needed
  done
}

systemctl_enable () {
  local services=$@
  for service in ${services[@]}; do
    sudo systemctl enable $service.service
    echo 'service:' $service
  done
}

systemctl_disable () {
  local services=$@
  for service in ${services[@]}; do
    sudo systemctl disable $service.service
    echo 'service disable:' $service
  done
}

systemctl_user_enable () {
  local services=$@
  for service in ${services[@]}; do
    systemctl --user enable $service.service
    echo 'service:' $service
  done
}
