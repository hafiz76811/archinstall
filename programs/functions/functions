pacman_install () {
  packages=$@
  for package in ${packages[@]}; do
    if pacman -Qs $package &> /dev/null && false || true; then
      sudo pacman -Sy $package --noconfirm
    else
      echo 'package:' $package '[installed]'
    fi
  done
}

yay_install () {
  packages=$@
