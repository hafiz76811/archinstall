# bspwm configs
if ! [ "$SHELL" = "/bin/zsh" ]; then
  chsh -s /bin/zsh
  localectl set-keymap us
  localectl set-locale LANG=en_US.UTF-8
  timedatectl set-timezone Asia/Jakarta
fi

