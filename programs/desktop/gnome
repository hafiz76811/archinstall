gnome_desktop=(
  gnome
  gnome-extra
  gnome-tweaks
  polkit-gnome
)

gnome_service=(
  gdm
)

gnome_theme=(
  adwaita-cursors
  adwaita-fonts
  adwaita-icon-theme
  adwaita-icon-theme-legacy
  gnome-themes-extra
)

# gnome configs
if ! [ "$SHELL" = "/bin/zsh" ]; then
  chsh -s /bin/zsh
  localectl set-keymap us
  localectl set-locale LANG=en_US.UTF-8
  timedatectl set-timezone Asia/Jakarta
fi
